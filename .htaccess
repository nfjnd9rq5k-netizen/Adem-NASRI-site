# Redirige les anciennes URLs .html (orphelines sur le serveur)
# vers les jolies URLs propres. 301 pour le SEO.
Redirect 301 /projets.html /projets/
Redirect 301 /contact.html /contact/
Redirect 301 /index.html /
# mod_alias compare ses motifs a l'URL DECODEE : un motif contenant %20 ne
# peut jamais correspondre. On accepte donc l'espace sous ses trois formes.
# >>> genere par build.py — ne pas editer a la main
# Les anciennes adresses du CV pointent vers le fichier empreinte du moment.
RedirectMatch 301 "^/cv-adem-nasri\.pdf$" /cv-adem-nasri.6343d3d69e.pdf
RedirectMatch 301 "^/CV(?:%20|[ +])Adem(?:%20|[ +])Nasri(?:%20|[ +])FR(?:%20|[ +])Mainframe\.pdf$" /cv-adem-nasri.6343d3d69e.pdf
# <<< fin du bloc genere

RewriteEngine On

# Un seul hote. www.adem-nasri.fr repondait 200 comme le domaine nu : deux
# adresses pour le meme contenu. Le canonical le disait deja, mais une
# redirection le rend opposable. Placee avant la regle HTTPS, la bascule
# http://www -> https://apex se fait en un seul saut.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# Force HTTPS (au cas où)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Sources de fabrication : jamais servies.
# Le Disallow du robots.txt n'interdit rien — il signale seulement un chemin
# aux robots qui veulent bien le lire. gen.py, data.py et le reste etaient
# telechargeables en clair. Ici le serveur refuse, ce qui est opposable.
RedirectMatch 404 "^/(tools|cv-source)/|^/build\.py$"

# La page 403 dans la charte du site plutot que la page brute du serveur.
# (« Options -Indexes » serait redondant : le listing est deja desactive,
# et une directive Options non autorisee ferait echouer tout le fichier.)
ErrorDocument 403 /404.html

# Compression gzip pour text/CSS/JS/SVG/HTML/XML/JSON/WOFF
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

# Cache long pour les assets versionnés statiquement (images/fonts/CSS/JS)
# Deux regimes de cache, selon que le fichier porte une empreinte ou non.
#
# Un fichier empreinte (styles.a16da5cc66.css, chalery-scroll.8fde….webp,
# cv-adem-nasri.422a….pdf) ne change JAMAIS de contenu : son nom change quand
# son contenu change. On peut donc le cacher un an et le declarer immutable.
#
# Un fichier sans empreinte peut, lui, etre remplace sous le meme nom. Un cache
# long le fige alors chez les visiteurs et dans le CDN — c'est ce qui a servi
# pendant des semaines une ancienne feuille de style et un ancien CV. On le
# garde donc court, pour que toute erreur se repare d'elle-meme en une heure.
<IfModule mod_headers.c>
  <FilesMatch "\.[0-9a-f]{10}\.(css|js|webp|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 hour"
  ExpiresByType image/png         "access plus 1 week"
  ExpiresByType image/jpeg        "access plus 1 week"
  ExpiresByType image/svg+xml     "access plus 1 week"
  ExpiresByType text/css          "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript   "access plus 1 hour"
  ExpiresByType application/pdf   "access plus 1 hour"
  # HTML court — pour pouvoir pousser des modifs rapidement
  ExpiresByType text/html         "access plus 5 minutes"
</IfModule>

# Sécurité de base
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "interest-cohort=()"
</IfModule>

# Une vraie page 404, avec son code 404.
# Rediriger toute URL inconnue vers l'accueil produit des « soft 404 » :
# Search Console les signale, et surtout ca masque les liens reellement casses.
ErrorDocument 404 /404.html
